          "in" : "query",
          "name" : "year",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 2030,
            "minimum" : 2015
          }
        }, {
          "in" : "query",
          "name" : "state",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Z]{2}"
          }
        }, {
          "in" : "query",
          "name" : "vaccine",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Z0-9_]{2,20}"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseStateCoverage"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "analytics-controller" ]
      }
    },
