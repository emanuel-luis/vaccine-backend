          "schema" : {
            "type" : "string",
            "pattern" : "[A-Z0-9_]{2,20}"
          }
        }, {
          "in" : "query",
          "name" : "dose",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "[A-Za-z0-9_]{1,10}"
          }
        }, {
          "in" : "query",
          "name" : "ageBand",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 6,
            "minimum" : 0
