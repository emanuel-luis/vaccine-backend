        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseTimeseriesPoint"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "dashboard-controller" ]
      }
