# Copy to .env (gitignored) and adjust. `make up` and `make demo` create .env from this file
# when it is missing. Local development values only; never reuse them anywhere else.

# Postgres container and the API's connection to it.
POSTGRES_DB=vaccine
POSTGRES_USER=vaccine
# Required. Any local-only value works; compose refuses to start without it.
POSTGRES_PASSWORD=change-me-local-only
# Host ports published by compose.
POSTGRES_PORT=5432
API_PORT=8080

# Keycloak (realm `vaccine`, imported from keycloak/realm-vaccine.json) and the web origin it
# redirects back to. The passwords and client secrets below are local-only placeholders: compose
# refuses to start without them, and Keycloak substitutes them into the realm on import.
# Changing them later needs `make down` (the dev realm is re-imported on a fresh start).
KEYCLOAK_PORT=8180
WEB_PORT=8081
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
# One password for every demo user (profissional.salvador, profissional.bahia, gestor.bahia,
# gestor.nacional, admin.dados).
KC_DEMO_PASSWORD=change-me-local-only
# Client-credentials secrets: vaccine-simulator (posts doses) and vaccine-smoke (smoke.sh and
# speed-check.sh read them from here and never print them).
SIMULATOR_CLIENT_SECRET=change-me-local-only
SMOKE_CLIENT_SECRET=change-me-local-only

# Host-side tools (`make load-reference`, `make generate`, dbt, psql) get the libpq variables
# PGHOST, PGPORT, PGDATABASE, PGUSER and PGPASSWORD mapped from the values above by the Makefile,
# so the password is set in one place only.
