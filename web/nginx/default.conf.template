# Rendered by the image entrypoint (envsubst on /etc/nginx/templates). Only API_* and OIDC_*
# variables are substituted (NGINX_ENVSUBST_FILTER), so nginx's own $variables stay intact.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' ${OIDC_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime config for the SPA, built from container env.
    location = /config.json {
        default_type application/json;
        expires -1;
        return 200 '{"apiBaseUrl":"${API_BASE_URL}","oidc":{"authority":"${OIDC_AUTHORITY}","clientId":"${OIDC_CLIENT_ID}"}}';
    }

    # SSE: no buffering, no compression, long read timeout.
    location /api/v1/stream {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The MapLibre worker is a module worker (.mjs); nginx's default mime types serve it as
    # octet-stream, which browsers refuse for a module script.
    location ~ ^/assets/.+\.mjs$ {
        default_type text/javascript;
        expires 1y;
        try_files $uri =404;
    }

    # Hashed build output.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Map geometries copied at build time; served as JSON so gzip applies.
    location /geo/ {
        types { application/json geojson; }
        expires 1d;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
    }

    # SPA fallback.
    location / {
        try_files $uri /index.html;
    }
}
